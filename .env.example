# Copiar como .env solo si se desea personalizar la ejecución.
# Luego iniciar Uvicorn con: python -m uvicorn app.main:app --reload --env-file .env
# La aplicación funciona sin este archivo.
APP_NAME=Tótem de triaje preventivo - Base educativa
APP_VERSION=0.1.0
DATABASE_URL=sqlite:///./data/totem_triaje.db
DATABASE_ECHO=false
# Opcional: activa el análisis orientativo de IA en informes mediante Gemini.
# El análisis nunca reemplaza una regla clínica aprobada ni la revisión profesional.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
